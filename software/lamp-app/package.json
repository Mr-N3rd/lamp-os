{
  "name": "lamp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "type-check": "vue-tsc --build tsconfig.app.json",
    "lint": "eslint && prettier --check src/",
    "format": "eslint --fix && prettier --write src/"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.18",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "4.5.0",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.6.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "4.5.14",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.4"
  }
}
