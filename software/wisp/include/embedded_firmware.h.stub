// Stub for the embedded signed lamp firmware blob.
//
// PURPOSE: The wisp build embeds a signed lamp firmware blob as
// `kEmbeddedFirmware[]` so it can stream the bytes to lamps over ESP-NOW
// (see FirmwareCarrier). The real blob is ~1.40 MB and is produced by
// `scripts/embed_firmware.py` (build-tooling implementer's territory).
//
// Until that tool runs, this stub provides a minimal placeholder:
// 200 bytes of 0xFF padding. The LSIG magic is intentionally absent so
// FirmwareCarrier::begin() recognises an "unprovisioned" build and stays
// in Disabled mode — wisp continues palette work, FirmwareDistributor
// never offers anything, no harm done.
//
// CONTRACT (also satisfied by the real generated header):
//   constexpr uint8_t kEmbeddedFirmware[N] = { ... };
//   constexpr size_t  kEmbeddedFirmwareLen = sizeof(kEmbeddedFirmware);
//
// The wisp source includes embedded_firmware.h (NOT this stub directly);
// embedded_firmware.h currently #includes this stub. Once the
// embed_firmware.py pipeline lands, embedded_firmware.h will #include a
// generated, .gitignored header instead.

#pragma once

#include <cstddef>
#include <cstdint>

namespace wisp {

// 200 bytes of 0xFF. Intentionally lacks the LSIG magic at the tail so
// FirmwareCarrier::begin() reports "no carrier" and the distributor
// stays Disabled.
constexpr uint8_t kEmbeddedFirmware[] = {
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
};
constexpr size_t kEmbeddedFirmwareLen = sizeof(kEmbeddedFirmware);

}  // namespace wisp
